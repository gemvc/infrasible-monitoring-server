# Build Infrasible Agent from public GitHub (Linux-only daemon).
ARG AGENT_REPO=https://github.com/gemvc/infrasible-agent.git
ARG AGENT_REF=main

FROM golang:1.23-bookworm AS build
ARG AGENT_REPO
ARG AGENT_REF
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git clone --depth 1 --branch "${AGENT_REF}" "${AGENT_REPO}" .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/infrasible-agent .

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && useradd --system --home /var/lib/infrasible-agent --shell /usr/sbin/nologin infrasible-agent \
  && mkdir -p /etc/infrasible-agent /var/lib/infrasible-agent \
  && chown -R infrasible-agent:infrasible-agent /var/lib/infrasible-agent /etc/infrasible-agent
COPY --from=build /out/infrasible-agent /usr/bin/infrasible-agent
USER infrasible-agent
ENTRYPOINT ["/usr/bin/infrasible-agent"]
CMD ["run", "--config=/etc/infrasible-agent/config.json"]
