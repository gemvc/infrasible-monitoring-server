#!/bin/sh
# Stop the service before package removal when systemd is available.
set -e

case "$1" in
remove|deconfigure)
	if command -v systemctl >/dev/null 2>&1; then
		systemctl stop infrasible-relay.service >/dev/null 2>&1 || true
		systemctl disable infrasible-relay.service >/dev/null 2>&1 || true
	fi
	;;
esac

exit 0
